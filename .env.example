# Copy to `.env.local` (gitignored) and fill in the values from the Accelerator panel.
# `npm run dev` starts the Accelerator dev tunnel only when all three are set.
# See README.md (Running locally) and .agents/skills/ring-module-local-development.

# Vhost of the module's Module Application, as registered in Ring Accelerator.
ACC_DEV_TUNNEL_VHOST=my-module.example.com
# Name of the development variant whose upstream type is "Dev tunnel".
ACC_DEV_TUNNEL_VARIANT=DEV_1
# JWT shown in the Accelerator panel after deploying that variant. Treat it like a password.
ACC_DEV_TUNNEL_TOKEN=
