{
    "name": "ring-example-module",
    "private": true,
    "type": "module",
    "engines": {
        "node": "24"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "lint": "npm run lint:js",
        "lint:js": "eslint --ext .js,.jsx,.ts,.tsx src/ vite.config.ts",
        "lint:js:fix": "npm run lint:js -- --fix",
        "prepare": "npm run build",
        "start": "vite --port 3003"
    },
    "dependencies": {
        "@emotion/react": "~11.14.0",
        "@emotion/styled": "~11.14.0",
        "@mui/icons-material": "~7.3.0",
        "@mui/material": "~7.3.0",
        "@mui/x-data-grid": "~8.17.0",
        "@mui/x-data-grid-pro": "~8.17.0",
        "@mui/x-license": "~8.17.0",
        "@reduxjs/toolkit": "~2.11.0",
        "@ringpublishing/mui-components": "~1.16.6",
        "@ringpublishing/ui-sdk-types": "1.0.0-alpha.1",
        "dayjs": "~1.11.0",
        "react": "~19.2.0",
        "react-dom": "~19.2.0",
        "react-redux": "~9.2.0",
        "react-router-dom": "~7.14.0"
    },
    "devDependencies": {
        "@ringieraxelspringer/eslint-config": "^24.0.0",
        "@ringieraxelspringer/tsconfig": "^7.0.0",
        "@types/node": "^24.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^6.0.0",
        "eslint": "^8.0.0",
        "typescript": "^5.0.0",
        "vite": "^8.0.0"
    },
    "eslintConfig": {
        "extends": [
            "@ringieraxelspringer/eslint-config"
        ]
    }
}
